# LINE Login Credentials
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Firebase Service Account (Optional if running in Cloud Run with default SA)
# Should be a JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# Absolute origin of the /api/ocr/* routes, e.g. https://api.example.com
#
# Leave empty for web/dev: the app and the API share an origin there, so a
# relative path works. REQUIRED for the installed iOS/Android app — it serves
# its bundle from capacitor://localhost (iOS) or https://localhost (Android),
# where a relative /api/... hits the bundled assets and no server. Without
# this, card OCR and auto-contour detection cannot work on device.
VITE_API_BASE_URL=
